# Prisma CLI (migrate, generate, studio, seed) loads this file via prisma.config.ts.
# Next.js also loads it automatically at runtime. This file is gitignored — never commit real secrets.

# Supabase project settings > Database > Connection string (URI)
# Use the SESSION pooler (port 5432 on the pooler host), not the TRANSACTION pooler (port 6543):
# `prisma migrate dev` needs to create a temporary shadow database, which the transaction pooler
# (pgbouncer) does not support. New Supabase projects also don't expose a direct db.<ref>.supabase.co
# host over IPv4, so the session pooler is the option that works in both cases.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@YOUR-REGION.pooler.supabase.com:5432/postgres"

# Supabase project settings > API (Project URL + service_role secret key)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Used once by `npx prisma db seed` to create the initial admin account
ADMIN_EMAIL="admin@appwebplus.tn"
ADMIN_PASSWORD="change-me-before-seeding"

# Random long string used to sign admin session JWTs (e.g. `openssl rand -base64 32`)
SESSION_SECRET="replace-with-a-long-random-string"

# Production URL, used for robots.txt / sitemap.xml. Optional for local dev (defaults to localhost:3000).
SITE_URL="https://appwebplus.tn"
